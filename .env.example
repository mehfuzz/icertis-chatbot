# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Google Gemini (free tier)
# Get key: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here
# Optional overrides — auto-detected from ListModels/defaults if not set
# GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET_KEY=change-this-to-a-strong-password

# ============================================================
# RAG Thresholds (tunable)
# ============================================================
CUSTOM_QUERY_THRESHOLD=0.85
RAG_THRESHOLD=0.70
RAG_TOP_K=5
